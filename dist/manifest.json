{
  "manifest_version": 3,
  "name": "X Media Downloader",
  "version": "7.7.0",
  "description": "X (Twitter) 媒体批量下载：React 动效 UI（beUI）、缩略图勾选、增量备份、API 分页抓取、自定义文件夹保存。",
  "permissions": ["storage", "downloads", "contextMenus", "notifications", "alarms", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X Media Downloader（点击展开面板）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "injected.js", "gallery.html", "assets/*"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
